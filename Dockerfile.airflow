# Airflow 2.10.5 (the version the DAG was tested on) + an isolated venv for pipeline code.
# Airflow pins SQLAlchemy 1.4; the pipeline needs 2.x, so tasks run in /opt/pipeline-venv via ExternalPythonOperator.
FROM apache/airflow:2.10.5-python3.11
USER root
COPY requirements-pipeline.txt /tmp/requirements-pipeline.txt
RUN python -m venv /opt/pipeline-venv \
 && /opt/pipeline-venv/bin/pip install --no-cache-dir -r /tmp/requirements-pipeline.txt \
 && chown -R airflow /opt/pipeline-venv
USER airflow
ENV PIPELINE_PYTHON=/opt/pipeline-venv/bin/python PROJECT_DIR=/app
